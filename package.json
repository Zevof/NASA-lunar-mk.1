{
  "name": "lunar-link-planner",
  "version": "7.0.0",
  "description": "NASA-grade interactive 3D solar system, lunar terrain and delta-V route planner",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "python serve.py 8765",
    "test": "node --test --test-concurrency=1 tests/ && node browsertest/run-browser-tests.mjs",
    "test:unit": "node --test --test-concurrency=1 tests/",
    "test:browser": "node browsertest/run-browser-tests.mjs",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:apk": "npm run cap:sync && npm run android:build"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "playwright": "^1.65.0",
    "puppeteer": "^25.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
